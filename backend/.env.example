# ── SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_gmail_app_password
SMTP_FROM=your_email@gmail.com

# ── Judge0 (code execution) ──────────────────────────────────────────
JUDGE0_API_KEY=your_rapidapi_judge0_key
JUDGE0_HOST=judge0-ce.p.rapidapi.com
# JUDGE0_TIMEOUT=10.0
# JUDGE0_LANGUAGE_IDS={"python":71,"javascript":63,"java":62,"c":50,"csharp":51}

# ── AI Interviewer: LLM providers (set at least one) ─────────────────
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-1.5-flash
# AI_INTERVIEWER_GEMINI_MODEL=gemini-1.5-pro
# OPENAI_API_KEY=your_openai_api_key
# CLAUDE_API_KEY=your_anthropic_api_key
# GROQ_API_KEY=your_groq_api_key

# ── AI Interviewer: Voice pipeline (STT/TTS) ─────────────────────────
# DEEPGRAM_API_KEY=your_deepgram_api_key        # STT for voice-mode answers
# ELEVENLABS_API_KEY=your_elevenlabs_api_key     # TTS for spoken interviewer responses
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM       # default: Rachel

# ── Redis / optional infra ───────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0
