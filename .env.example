# ── App ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false

# ── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_interview
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── Auth / JWT ────────────────────────────────────────────────────────
JWT_SECRET=              # leave blank to auto-generate and persist
JWT_EXPIRY_HOURS=24

# ── SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_gmail_app_password
SMTP_FROM=your_email@gmail.com

# ── External APIs ─────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key   # the single LLM provider powering Obi
OPENAI_MODEL=gpt-5.6-luna            # Luna is Obi's reasoning brain
# If Luna is served via OpenRouter's OpenAI-compatible endpoint (OpenRouter key, model slug "openai/gpt-5.6-luna"):
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=openai/gpt-5.6-luna
# Faster model for latency-critical interview nodes (question/answer/follow-up).
# Leave blank to reuse OPENAI_MODEL.
OPENAI_FAST_MODEL=
JUDGE0_API_KEY=your_rapidapi_judge0_key
JUDGE0_HOST=judge0-ce.p.rapidapi.com

# ── AI Interviewer ─────────────────────────────────────────────────────
# LLM (used for interview intelligence — powered by OPENAI_MODEL, default gpt-5.6-luna)
AI_INTERVIEWER_MAX_QUESTIONS=12
AI_INTERVIEWER_TEMPERATURE=0.7
AI_INTERVIEWER_SESSION_TTL_HOURS=4

# STT: Deepgram (primary - recommended)
DEEPGRAM_API_KEY=your_deepgram_api_key

# STT: Groq Whisper (fallback - faster than OpenAI Whisper)
GROQ_API_KEY=your_groq_api_key

# TTS: ElevenLabs (primary - highest quality, ~400ms latency)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Rachel - neutral, professional

# STT/TTS Fallback: OpenAI Whisper + OpenAI TTS (same OPENAI_API_KEY as the LLM)
OPENAI_TTS_VOICE=alloy

# ── CORS (comma-separated origins) ───────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Uploads ───────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760

# ── OTP / Captcha ────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
CAPTCHA_TTL_SECONDS=300
OTP_RATE_LIMIT=5
OTP_RATE_WINDOW=600

# ── Rate Limits ───────────────────────────────────────────────────────
CODE_RATE_LIMIT=20
CODE_RATE_WINDOW=600
AI_RATE_LIMIT=10
AI_RATE_WINDOW=600
ADMIN_RATE_LIMIT=30
ADMIN_RATE_WINDOW=600

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Session cleanup ───────────────────────────────────────────────────
SESSION_RETENTION_DAYS=30
